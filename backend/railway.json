[build]
  command = "pip install -r requirements.txt"
  watch_patterns = ["../product_tool/**", "*.py"]

[deploy]
  start_command = "uvicorn main:app --host 0.0.0.0 --port $PORT"
  healthcheck_path = "/api/health"
  restart_policy = "always"
  sleep_on_idle = true
  idle_timeout_minutes = 5

# 必须设置的环境变量:
#   JWT_SECRET_KEY        — 用于 JWT 签名的密钥, 生成: python -c "import secrets; print(secrets.token_hex(32))"
# 可选环境变量:
#   GEMINI_API_KEY        — Gemini AI 列检测 API Key
#   PRODUCT_TOOL_DB_PATH  — 产品库 SQLite 路径 (默认 ~/.product_tool/products.db)
#   COMPANY_CONFIG_PATH   — 公司配置文件路径 (默认 ~/.product_tool/company.json)
