# ============================================
# QuoteFlow 环境变量配置
# 复制此文件为 backend/.env 并填入实际值
# ============================================

# === 必填 ===
JWT_SECRET_KEY=生成一个至少32位的随机字符串
BASE_URL=https://quoteflow.it.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# === 数据库 (默认 SQLite，不填即可) ===
# DATABASE_URL=sqlite+aiosqlite:///./app.db
# 如果用 PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# === 支付 (Creem) ===
# Creem 后台 → Settings → API Keys → Secret Key
CREEM_API_KEY=creem_secret_xxx
# Creem 后台 → Settings → Webhooks → 添加 URL https://api.quoteflow.it.com/api/payment/webhook
CREEM_WEBHOOK_SECRET=whsec_xxx
# Creem 后台 → Products → 复制 Product ID
CREEM_PRODUCT_ID_PRO=prod_xxx

# === 错误监控 (Sentry，免费) ===
# 注册 sentry.io → Create Project → FastAPI → 复制 DSN
SENTRY_DSN=https://xxxxxxxxxxxx@sentry.io/xxxxxxx

# === 邮件 (Resend，免费 100封/天) ===
# 注册 resend.com → API Keys → Create API Key
# 然后 Add Domain → quoteflow.it.com (需添加 DNS 记录)
RESEND_API_KEY=re_xxxxxxxxxxxx

# === SMTP 备选邮件 (如果用 QQ邮箱/企业邮箱/阿里云邮件) ===
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=你的邮箱@qq.com
# SMTP_PASSWORD=授权码（QQ邮箱→设置→账户→POP3/SMTP→生成授权码）

# === 日志 ===
# 设为 1 启用结构化 JSON 日志（方便对接日志平台）
LOG_JSON=1

# === 前端 ===
# 在 Vercel Dashboard → Settings → Environment Variables 中设置：
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@sentry.io/xxxxxxx
