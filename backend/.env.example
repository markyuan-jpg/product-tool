# backend/.env — 后端环境变量
# 复制此文件为 .env 并填写真实值

# ─── 必填 ───
DATABASE_URL=postgresql+asyncpg://postgres:xxxx@xxxx.supabase.co:5432/postgres
JWT_SECRET_KEY=your-jwt-secret-min-32-chars

# ─── Creem 支付（可选，不填则支付功能不可用）───
CREEM_API_KEY=creem_live_xxx
CREEM_WEBHOOK_SECRET=whsec_xxx
CREEM_PRODUCT_ID_PRO=prod_xxx
CREEM_BASE_URL=https://api.creem.io/v1
BASE_URL=http://localhost:3000

# ─── 可选 ───
GEMINI_API_KEY=
USE_DOCLING=0
PRICE_CONFIG_PATH=
COMPANY_CONFIG_PATH=
PRODUCT_TOOL_DB_PATH=  # 产品库 SQLite 路径，默认 ~/.product_tool/products.db
